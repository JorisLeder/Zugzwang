# Zugzwang – environment variables (copy to .env.local and fill in).
#
# Without VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY the app runs in LOCAL MODE:
# no login, all progress is stored in this browser (IndexedDB) only, and the app says so
# ("Lokaler Modus – Fortschritt nur auf diesem Gerät"). Set both to enable CLOUD MODE
# (login, sync across devices). Setup: README.md, section "Cloud-Sync einrichten (Supabase)".
# Only public values belong here: the anon key is public by design, the service-role key
# and the Claude API key must never be put into a VITE_ variable.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Supabase anon / publishable (public) key (Project Settings -> API Keys)
VITE_SUPABASE_ANON_KEY=
# Optional: use the Lichess cloud evaluation as an accelerator for game analysis ("true"/"false").
# The local Stockfish engine is always the fallback.
VITE_CLOUD_EVAL=false
